# Copier ce fichier en .env pour le développement local. Ne JAMAIS versionner .env.
NODE_ENV=development
PORT=3000
NIVEAU_JOURNAL=info
# 0 en local ; 1 derrière le reverse proxy de Render
NOMBRE_PROXYS_DE_CONFIANCE=0

# Base locale lancée par « docker compose up -d » (aucun mot de passe, accès 127.0.0.1 uniquement)
DATABASE_URL=postgres://gml_shield@127.0.0.1:5433/gml_shield
# Production (Supabase) : vérification complète du certificat TLS du serveur PostgreSQL
# CHEMIN_CERTIFICAT_CA_BASE=certificats/supabase-ca-2021.crt

# Secret de signature des jetons de session (32 caractères minimum). Générer une valeur avec :
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
SECRET_JWT=
DUREE_SESSION_MINUTES=15
# Adresse publique du client web : seule origine autorisée pour les requêtes POST/PATCH/DELETE
# (sur Render, RENDER_EXTERNAL_URL est utilisée si cette variable est absente)
ORIGINE_AUTORISEE=http://localhost:3000

# Mot de passe des comptes de démonstration créés par « npm run comptes:demo » (12 caractères minimum)
MOT_DE_PASSE_COMPTES_DEMO=

# Clé AES-256 de chiffrement des codes d'accès (32 octets en base64). Générer avec :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CLE_CHIFFREMENT_SECRETS=

# Stockage privé des preuves de livraison : « disque » (local) ou « supabase » (production)
STOCKAGE_PREUVES=disque
DOSSIER_PREUVES=stockage-prive/preuves
# Requis uniquement avec STOCKAGE_PREUVES=supabase (clé secrète : serveur uniquement)
SUPABASE_URL=
SUPABASE_CLE_SECRETE=
COMPARTIMENT_PREUVES=preuves-livraison
