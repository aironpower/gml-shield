{
  "name": "gml-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Messagerie opérationnelle sécurisée répartiteur ↔ chauffeur de GreenMove Logistics",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/serveur.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/serveur.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:verifier": "prettier --check .",
    "typage": "tsc --noEmit",
    "test": "vitest run",
    "test:couverture": "vitest run --coverage",
    "verifier": "npm run format:verifier && npm run lint && npm run typage && npm run test:couverture",
    "migrer": "tsx --env-file=.env src/migrer.ts",
    "migrer:production": "node dist/migrer.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
